{
  "name": "@rewire/omics-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/functions.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "check:functions:load": "node -e \"const f=require('./dist/functions.js'); if(!f.contributions || !f.contributionMail) process.exit(1)\"",
    "dev": "tsx src/server.ts",
    "test": "tsx --test test/*.test.ts",
    "test:emulator": "firebase emulators:exec --project demo-rewire-omics --only auth,firestore 'npm test'",
    "curator": "tsx src/cli.ts",
    "import-release": "tsx src/import-cli.ts",
    "mail:drain": "tsx src/mail-worker.ts"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@trpc/server": "^11.0.0",
    "firebase-admin": "14.4.0",
    "firebase-functions": "7.4.0",
    "nodemailer": "10.0.10",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@trpc/client": "^11.0.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^7.0.0",
    "firebase-tools": "15.30.1",
    "prettier": "^3.9.7",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "gaxios": {
      "uuid": "11.1.1"
    }
  }
}
