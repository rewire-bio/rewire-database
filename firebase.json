      "port": 5001
    },
    "auth": {
      "host": "127.0.0.1",
      "port": 9099
    },
    "firestore": {
      "host": "127.0.0.1",
      "port": 8085
    }
  },
  "functions": [
    {
      "source": "services/omics",
      "codebase": "omics",
      "runtime": "nodejs22",
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ],
      "ignore": [
        "node_modules",
        "test",
        "*debug.log",
        ".env",
        ".env.*",
        ".secret.local",
        ".git",
        ".firebase"
      ]
    }
  ],
  "firestore": {
    "rules": "services/omics/firestore.rules",
    "indexes": "services/omics/firestore.indexes.json"
  }
