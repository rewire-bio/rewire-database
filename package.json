{
  "name": "rewire-database",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run omics:release && npm run export:benchmark-literature && next dev",
    "build": "npm run omics:release && npm run validate:benchmark-literature && npm run export:benchmark-literature && next build",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "validate:benchmark-literature": "node scripts/validate-benchmark-literature.mjs",
    "export:benchmark-literature": "node scripts/export-benchmark-literature.mjs",
    "test": "vitest run",
    "check:export": "node scripts/check-export.mjs && tsx scripts/omics/check-export.ts",
    "preview": "wrangler dev",
    "deploy": "wrangler deploy",
    "omics:migrate": "tsx scripts/omics/migrate.ts",
    "omics:release": "tsx scripts/omics/release.ts",
    "omics:check-sources": "tsx scripts/omics/check-literature.ts",
    "test:omics": "vitest run tests/omics-*.test.ts",
    "omics:service:test": "npm --prefix services/omics run test:emulator",
    "omics:check-updates": "tsx scripts/omics/check-updates.ts",
    "omics:check-export": "tsx scripts/omics/check-export.ts"
  },
  "dependencies": {
    "@trpc/client": "^11.18.0",
    "firebase": "^12.19.0",
    "lucide-react": "^0.473.0",
    "next": "14.2.16",
    "react": "^18",
    "react-dom": "^18",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.16",
    "fast-xml-parser": "^5.11.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^1.0.4",
    "wrangler": "4.132.0"
  },
  "engines": {
    "node": ">=22"
  }
}
