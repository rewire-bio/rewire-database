{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rewire-database-web",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  // Pages come from the Next.js server on Cloud Run (its run.app URL). The
  // Worker holds no data release, so neither frontend nor data publication
  // redeploys it. An empty value answers 503 rather than proxying elsewhere.
  "vars": {
    "FRONTEND_ORIGIN": ""
  }
}
