{
  "hosting": {
    "site": "rewire-it",
    "public": "out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": true,
    "headers": [
      {
        "source": "/deployment{.json,}",
        "headers": [{ "key": "Cache-Control", "value": "no-store" }]
      },
      {
        "source": "/_analytics/**",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "frame-ancestors https://benchmarks.rewire.it https://benchmarks.rewirebio.io"
          },
          {
            "key": "Cache-Control",
            "value": "no-store"
          },
          {
            "key": "Referrer-Policy",
            "value": "no-referrer"
          },
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          }
        ]
      },
      {
        "source": "/icon",
        "headers": [
          {
            "key": "Content-Type",
            "value": "image/png"
          }
        ]
      },
      {
        "source": "/apple-icon",
        "headers": [
          {
            "key": "Content-Type",
            "value": "image/png"
          }
        ]
      },
      {
        "source": "/_next/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      },
      {
        "source": "/contribute{,/**}",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          },
          {
            "key": "Referrer-Policy",
            "value": "no-referrer"
          },
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": {
          "functionId": "contributions",
          "region": "europe-west2"
        }
      }
    ],
    "redirects": [
      {
        "source": "/database{,/}",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/literature{,/}",
        "destination": "/?kind=result&origin=literature",
        "type": 301
