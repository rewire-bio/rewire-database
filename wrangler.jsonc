{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rewire-database-web",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  "assets": {
    "directory": ".cloudflare/assets",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/omics",
      "/omics/*",
      "/api",
      "/api/*",
      "/__/auth",
      "/__/auth/*",
      "/database/result",
      "/database/result/*",
      "/database/evaluation",
      "/database/evaluation/*",
      "/database",
      "/database/",
      "/literature",
      "/literature/*",
      "/dna-genomes",
      "/dna-genomes/",
      "/rna-transcriptomes",
      "/rna-transcriptomes/",
      "/proteins-complexes",
      "/proteins-complexes/",
      "/cells-tissues",
      "/cells-tissues/",
      "/microbes-communities",
      "/microbes-communities/",
      "/molecular-interactions",
      "/molecular-interactions/"
    ]
  }
}
